# ─────────────────────────────────────────────────────────────────────────────
# Browser (bundled into the public site — never put secrets in VITE_* vars)
# ─────────────────────────────────────────────────────────────────────────────
# "mock" = sample data, "workday" = live jobs from the careers API server below
VITE_JOBS_PROVIDER=workday
# Where the site finds the careers API (same origin by default)
VITE_JOBS_API_URL=/api
# Optional: endpoint that receives job-alert sign-ups
# VITE_JOB_ALERTS_URL=

# ─────────────────────────────────────────────────────────────────────────────
# Careers API server (server/) — runs on Node, holds the Workday credentials
# ─────────────────────────────────────────────────────────────────────────────
PORT=8787
# How often to re-pull postings from Workday
WORKDAY_SYNC_INTERVAL_MINUTES=15
# Public Workday career site (used for "Apply" links), e.g.
# https://acme.wd5.myworkdayjobs.com/en-US/External
WORKDAY_CAREER_SITE_URL=
# Optional: allows POST /api/jobs/refresh with "Authorization: Bearer <secret>"
JOBS_REFRESH_SECRET=

# Pick ONE connection method: rest | raas | cxs
WORKDAY_SOURCE=

# ── Option 1 (recommended): Workday Recruiting REST API, OAuth 2.0 ──────────
# Host from the tenant's REST API endpoint, e.g. https://wd5-services1.myworkday.com
WORKDAY_HOST=
WORKDAY_TENANT=
WORKDAY_CLIENT_ID=
WORKDAY_CLIENT_SECRET=
WORKDAY_REFRESH_TOKEN=
# Optional: only pull postings for this Job Posting Site (external career site id)
WORKDAY_JOB_POSTING_SITE=
# Optional overrides if your tenant's URLs differ from the defaults:
#   {WORKDAY_HOST}/ccx/oauth2/{WORKDAY_TENANT}/token
#   {WORKDAY_HOST}/ccx/api/recruiting/v4/{WORKDAY_TENANT}
# WORKDAY_TOKEN_URL=
# WORKDAY_RECRUITING_API_URL=

# ── Option 2: Workday custom report (RaaS), ISU username + password ─────────
# e.g. https://wd5-services1.myworkday.com/ccx/service/customreport2/acme/ISU_Careers/Careers_Open_Job_Postings
WORKDAY_RAAS_URL=
WORKDAY_USERNAME=
WORKDAY_PASSWORD=

# ── Option 3: public career site feed (no credentials) ──────────────────────
# Uses WORKDAY_CAREER_SITE_URL above. Override if the URL doesn't follow
# https://{tenant}.wdN.myworkdayjobs.com/{site}:
# WORKDAY_CXS_TENANT=
# WORKDAY_CXS_SITE=
